# Copy to .env.local for local development. Never commit secrets.

# Required. PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional. If unset, the server generates a strong key once and stores it in
# the gitignored .runtime/jwt-secret file. Provide your own in deployment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
